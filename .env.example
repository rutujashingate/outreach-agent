# Groq is the chosen provider for your setup. It handles research, qualification,
# writing, and review. The fake demo and goal-only /outreach need no model key.
# Copy this template to .env, fill it in locally, and export the settings.
# The application does not automatically load .env files.
OUTREACH_MODEL_PROVIDER=groq
GROQ_API_KEY=
# A model hosted by Groq that supports JSON schema structured output.
# The openai/ prefix names the model; you do not need an OpenAI account for it.
GROQ_MODEL=openai/gpt-oss-120b

# Optional alternative only when OUTREACH_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
# Choose an API model available to your account that supports Structured Outputs.
OPENAI_MODEL=

# Full workflow: export a Brave key only if you use use_search=true.
BRAVE_SEARCH_API_KEY=
# A valid OAuth access token, obtained for your own Gmail account.
# Renew it when it expires. Gmail reads and writes are optional.
GMAIL_ACCESS_TOKEN=
OUTREACH_READ_GMAIL=false
# Sending stays disabled until explicitly enabled. A send run also needs
# gmail_action="send", a valid recipient, contact-policy clearance, and approval.
OUTREACH_ENABLE_SENDING=false

# Saved relationship information and workflow checkpoints are separate files.
OUTREACH_DATA_DIR=.data
OUTREACH_DATABASE_URL=
OUTREACH_CHECKPOINT_BACKEND=sqlite
OUTREACH_CHECKPOINT_POSTGRES_URL=
# Set this for a shared/deployed instance; clients send it as X-API-Key.
OUTREACH_API_KEY=
# Optional JSON overrides for app/security/limits.py. For example:
# {"concurrency":2,"max_model_calls":30,"max_search_calls":2}
OUTREACH_LIMITS_JSON={}
