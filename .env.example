# Copy to .env only if you do not already have one. Real values belong in .env.
# python -m app.main loads it automatically. Setup: docs/SETUP.md.

# Dashboard login and local address (also used by Google sign-in).
OUTREACH_OWNER_PASSWORD=
OUTREACH_APP_URL=http://127.0.0.1:8000

# Grok: one xAI API key for instruction following, tool reasoning, and research.
OUTREACH_MODEL_PROVIDER=xai
XAI_API_KEY=
XAI_INSTRUCTION_MODEL=grok-4.3
XAI_REASONING_MODEL=grok-4.20-0309-reasoning
XAI_RESEARCH_MODEL=grok-4.20-multi-agent-0309

# Telegram bot token and your own numeric user ID; private chats only.
OUTREACH_TELEGRAM_BOT_TOKEN=
OUTREACH_TELEGRAM_OWNER_ID=0

# Google OAuth and the Fernet key that encrypts saved Gmail tokens.
OUTREACH_GOOGLE_CLIENT_ID=
OUTREACH_GOOGLE_CLIENT_SECRET=
OUTREACH_SECRET_KEY=
OUTREACH_READ_GMAIL=true
# The agent creates requested drafts; you review and send them in Gmail.

# Brave discovers URLs. Supplying a URL directly works without a Brave key.
BRAVE_SEARCH_API_KEY=
OUTREACH_BROWSER_ENABLED=true

# Supabase: database session-pooler URL, project HTTPS URL, and server secret.
# These are separate credentials. See docs/SUPABASE.md for where to find them.
OUTREACH_SUPABASE_DATABASE_URL=
OUTREACH_SUPABASE_URL=
OUTREACH_SUPABASE_SECRET_KEY=
# Use local/false until setup; then choose supabase/true for the cloud library.
OUTREACH_DOCUMENT_STORAGE=local
OUTREACH_SEMANTIC_SEARCH_ENABLED=false

# Optional usage overrides. {} keeps the application defaults (not a bill).
OUTREACH_LIMITS_JSON={}
