# Copy this template to .env only if you do not already have one.
# python -m app.main loads .env automatically. Keep real values out of Git.
# This template is tracked by Git. Enter real passwords and keys only in .env.

# Owner login and the exact browser address (also used by Google sign-in).
OUTREACH_OWNER_PASSWORD=
OUTREACH_APP_URL=http://127.0.0.1:8000
OUTREACH_HOST=127.0.0.1
OUTREACH_PORT=8000
# Optional for scripts calling /api with X-API-Key; not needed by the dashboard.
OUTREACH_API_KEY=

# Groq handles interpretation, research reasoning, qualification, writing/review.
OUTREACH_MODEL_PROVIDER=groq
GROQ_API_KEY=
# The model name is hosted by Groq; no OpenAI account is needed for this choice.
GROQ_MODEL=openai/gpt-oss-120b
# Optional alternative, used only with OUTREACH_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# xAI / Grok preparation: the application connection is not implemented yet.
# Keep OUTREACH_MODEL_PROVIDER above unchanged; xai is not accepted yet.
# Paste your existing xAI key only into .env, never this shared template.
# These three fields are saved for setup and are not used by the current app.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_REASONING_EFFORT=none
# Set key rate limits, expiry, and billing limits in xAI Console, not here.

# Telegram: one bot token and your own numeric user ID. Private chats only.
OUTREACH_TELEGRAM_BOT_TOKEN=
OUTREACH_TELEGRAM_OWNER_ID=0

# Google OAuth: Web application client; see docs/SETUP.md for the callback URL.
OUTREACH_GOOGLE_CLIENT_ID=
OUTREACH_GOOGLE_CLIENT_SECRET=
# A Fernet key generated once and retained separately from database backups.
OUTREACH_SECRET_KEY=
OUTREACH_READ_GMAIL=true
OUTREACH_ENABLE_SENDING=false

# Brave is optional when supplying URLs or notes yourself.
BRAVE_SEARCH_API_KEY=
OUTREACH_BROWSER_ENABLED=true
# Local OCR language codes; install matching Tesseract language data.
OUTREACH_OCR_LANGUAGES=eng

# SQLite is sufficient: leave the URLs empty. Two files, one database engine.
OUTREACH_DATA_DIR=.data
OUTREACH_DATABASE_URL=
OUTREACH_CHECKPOINT_BACKEND=sqlite
OUTREACH_CHECKPOINT_POSTGRES_URL=

# JSON overrides for app/services/limits.py. Costs below are reservations,
# not actual provider prices. Default cap: $2 estimated, $0.05 per model call.
# Example lower cap: {"max_estimated_cost_per_run":0.50,"max_model_calls":10}
OUTREACH_LIMITS_JSON={}
