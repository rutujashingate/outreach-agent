---
flowchart LR
    accTitle: Creating a new email and editing an existing draft
    accDescr: A new draft request researches contacts if needed, writes and reviews, then saves a Gmail draft. An existing-draft edit reads and revises the message, waits for owner approval, then updates the same draft; rejection leaves it unchanged. The owner sends manually in Gmail.
    subgraph new["NEW EMAIL"]
        request["Your draft request"] --> research["Research if needed"]
        research --> write["Write + review"]
        write --> save["Save Gmail draft"]
    end
    subgraph edit["EXISTING DRAFT"]
        change["Your edit request"] --> read["Read + revise"]
        read --> approve{"Your approval"}
        approve -->|Approve| update["Update same draft"]
        approve -->|Reject| unchanged["Keep unchanged"]
    end
    save --> owner["You send in Gmail"]
    update --> owner
    classDef approval fill:#fff6e6,stroke:#caa65d,color:#5b451b;
    classDef owner fill:#edf3fc,stroke:#8da6c7,color:#243b58;
    class approve approval;
    class owner owner;
